---
# Copy to host_vars/127.0.0.1/custom.yml (git-ignored) and edit. Applied last: it wins over the
# repository defaults and the picker's selection.yml (./pick.py, which covers catalog packages and
# features; this file is for the rest). Ids come from group_vars/all/catalog.yml; names outside the
# catalog use a prefix: "pkg:<native package>", "flatpak:<app id>" or "pipx:<PyPI spec>" (a Python
# app installed for you with pipx).

# Features to switch (see group_vars/all/features.yml). Hardware ones accept only false (veto):
# the picker does not list them.
features: {}
#  nvidia: false
#  antigravity_ide: false

# Extra packages, installed after the base set
packages_add: []
#  - "pkg:sqlitebrowser"
#  - "flatpak:org.gimp.GIMP"
#  - "pipx:httpie"
# (Software from a vendor's releases, like Roboto on EL, is a catalog id too: skip or remove it
# by id. Sources: group_vars/all/upstream.yml.)

# Defaults not to install (never uninstalls anything)
packages_skip: []
#  - telegram

# Explicit uninstall (no autoremove). An id cannot be both installed and here.
packages_absent: []
#  - "pkg:akregator"

# ALPI's zsh aliases (group_vars/all/zsh.yml) switched on or off by name, over the picker's choice
# (./pick.py, "Shell aliases"). An alias whose program is not installed is left out anyway.
zsh_aliases_enabled: {}
#  clean-cache: false

# Zsh aliases for this machine only (roles/zsh, user's .zshrc). luks_volumes: name -> LUKS UUID
# (as in /dev/mapper/luks-<UUID>, or 'lsblk -o NAME,UUID'), giving open-<name> (unlock + mount) and
# close-<name> (unmount + lock) through udisksctl.
luks_volumes: {}
#  thevoid: ad99f7e6-cf3a-4581-9c46-de99119b00d4
zsh_aliases_custom: ""
#  alias vpn-on="nmcli connection up work-vpn"

# Flatpak overrides, applied only to apps being installed (group_vars/all/flatpak.yml).
# Extra host folders an app may read: a file dragged from a folder the sandbox was not granted
# reaches the app as a path it cannot open (ZapZap: "the file has no content"). ':ro' = read-only.
# ZapZap already gets ~/wks read-only from the repository (flatpak_overrides_common).
flatpak_filesystem_overrides: {}
#  com.rtosta.zapzap:
#    - "{{ user_home }}/Downloads:ro"
# Any other 'flatpak override' flags, added to the repository's (e.g. the KDE ones for Bitwarden).
flatpak_overrides: {}
#  com.spotify.Client:
#    - --socket=wayland

# Cedilla on KDE (group_vars/all/desktop.yml): under KWin 6.6, Chromium/Electron apps (Brave, VS
# Code, Antigravity, Slack, Spotify, Bitwarden) type "ć" on native Wayland, so ALPI runs them on
# XWayland. auto follows the KWin version; true/false force it (KDE only). Undone when off.
cedilla_xwayland: auto

# Swap on compressed RAM (group_vars/all/memory.yml). zram: auto turns it on unless the machine
# has its own zram setup or zswap is on; false switches it off. zram_size: a zram-generator
# expression (MiB, 'ram' = RAM), empty = min(ram, 8192). hibernate: true reminds you when the
# disk swap is smaller than RAM (ALPI never creates swap files).
zram: auto
zram_size: ""
#zram_size: "ram / 2"
hibernate: false
